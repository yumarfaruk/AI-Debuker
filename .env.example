# GEMINI_API_KEY: Required when PROVIDER=api (default).
# In Google AI Studio, this is automatically injected at runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PROVIDER: Select the AI backend.
# Options: 'api' (Google AI Studio Gemma 4) or 'local' (Ollama)
# Default: api
PROVIDER="api"

# GEMINI_MODEL: Exact Gemma 4 model ID on Google AI Studio / Gemini API.
# Options: 'gemma-4-26b-a4b-it' or 'gemma-4-31b-it'
GEMINI_MODEL="gemma-4-26b-a4b-it"

# OLLAMA_ENDPOINT: The local Ollama server URL (used when PROVIDER=local).
# Default: http://localhost:11434
OLLAMA_ENDPOINT="http://localhost:11434"

# OLLAMA_MODEL: The local Gemma model tag in Ollama.
# Default: gemma4:e2b
OLLAMA_MODEL="gemma4:e2b"

# PORT: The port the web server runs on (port 3000 in AI Studio)
PORT="3000"
